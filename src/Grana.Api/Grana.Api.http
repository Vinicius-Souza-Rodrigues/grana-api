@Grana.Api_HostAddress = http://localhost:5180

@contaId = {{criarConta.response.body.$.dados.id}}
@contaDestinoId = {{criarContaDestino.response.body.$.dados.id}}
@contaVaziaId = {{criarContaVazia.response.body.$.dados.id}}
@categoriaDespesaId = {{criarCategoriaDespesa.response.body.$.dados.id}}
@categoriaReceitaId = {{criarCategoriaReceita.response.body.$.dados.id}}
@categoriaSemUsoId = {{criarCategoriaSemUso.response.body.$.dados.id}}
@lancamentoId = {{criarLancamento.response.body.$.dados.lancamento.id}}
@transferenciaId = {{criarTransferencia.response.body.$.dados.transferencia.id}}
@token = {{login.response.body.$.dados.token}}

### Health check

GET {{Grana.Api_HostAddress}}/health

### Autenticação: registrar usuário

POST {{Grana.Api_HostAddress}}/api/auth/registrar
Content-Type: application/json

{
  "nome": "Maria Silva",
  "email": "maria@email.com",
  "senha": "senhaForte123"
}

### Autenticação: login (o token vai para as próximas requisições)

# @name login
POST {{Grana.Api_HostAddress}}/api/auth/login
Content-Type: application/json

{
  "email": "maria@email.com",
  "senha": "senhaForte123"
}

### Contas: criar conta de origem

# @name criarConta
POST {{Grana.Api_HostAddress}}/api/contas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Conta Principal",
  "tipo": "Corrente",
  "saldoInicial": 1500
}

### Contas: criar conta de destino

# @name criarContaDestino
POST {{Grana.Api_HostAddress}}/api/contas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Reserva",
  "tipo": "Poupanca",
  "saldoInicial": 0
}

### Contas: criar conta com saldo zero (usada para desativar e reativar)

# @name criarContaVazia
POST {{Grana.Api_HostAddress}}/api/contas
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Conta Vazia",
  "tipo": "Carteira",
  "saldoInicial": 0
}

### Contas: listar ativas

GET {{Grana.Api_HostAddress}}/api/contas
Authorization: Bearer {{token}}

### Contas: listar incluindo inativas

GET {{Grana.Api_HostAddress}}/api/contas?incluirInativas=true
Authorization: Bearer {{token}}

### Contas: buscar por id

GET {{Grana.Api_HostAddress}}/api/contas/{{contaId}}
Authorization: Bearer {{token}}

### Contas: renomear

PUT {{Grana.Api_HostAddress}}/api/contas/{{contaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Conta Principal Renomeada"
}

### Contas: desativar (só com saldo zero)

PATCH {{Grana.Api_HostAddress}}/api/contas/{{contaVaziaId}}/desativar
Authorization: Bearer {{token}}

### Contas: reativar

PATCH {{Grana.Api_HostAddress}}/api/contas/{{contaVaziaId}}/reativar
Authorization: Bearer {{token}}

### Categorias: criar de despesa com orçamento

# @name criarCategoriaDespesa
POST {{Grana.Api_HostAddress}}/api/categorias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Feira",
  "tipo": "Despesa",
  "orcamentoMensal": 800
}

### Categorias: criar de receita

# @name criarCategoriaReceita
POST {{Grana.Api_HostAddress}}/api/categorias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Bônus",
  "tipo": "Receita"
}

### Categorias: criar sem lançamentos (usada para excluir)

# @name criarCategoriaSemUso
POST {{Grana.Api_HostAddress}}/api/categorias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Temporária",
  "tipo": "Despesa"
}

### Categorias: listar

GET {{Grana.Api_HostAddress}}/api/categorias
Authorization: Bearer {{token}}

### Categorias: listar por tipo

GET {{Grana.Api_HostAddress}}/api/categorias?tipo=Despesa
Authorization: Bearer {{token}}

### Categorias: buscar por id

GET {{Grana.Api_HostAddress}}/api/categorias/{{categoriaDespesaId}}
Authorization: Bearer {{token}}

### Categorias: editar nome e orçamento

PUT {{Grana.Api_HostAddress}}/api/categorias/{{categoriaDespesaId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "nome": "Feira e Hortifruti",
  "orcamentoMensal": 900
}

### Categorias: excluir (só sem lançamentos)

DELETE {{Grana.Api_HostAddress}}/api/categorias/{{categoriaSemUsoId}}
Authorization: Bearer {{token}}

### Lançamentos: criar receita

POST {{Grana.Api_HostAddress}}/api/lancamentos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contaId": "{{contaId}}",
  "categoriaId": "{{categoriaReceitaId}}",
  "valor": 1000.00,
  "data": "2026-11-05",
  "descricao": "Bônus de fim de ano"
}

### Lançamentos: criar despesa

# @name criarLancamento
POST {{Grana.Api_HostAddress}}/api/lancamentos
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contaId": "{{contaId}}",
  "categoriaId": "{{categoriaDespesaId}}",
  "valor": 250.00,
  "data": "2026-11-20",
  "descricao": "Feira do mês"
}

### Lançamentos: listar

GET {{Grana.Api_HostAddress}}/api/lancamentos
Authorization: Bearer {{token}}

### Lançamentos: listar com filtros e paginação

GET {{Grana.Api_HostAddress}}/api/lancamentos?contaId={{contaId}}&tipo=Despesa&dataInicio=2026-11-01&dataFim=2026-11-30&busca=feira&pagina=1&tamanhoPagina=20
Authorization: Bearer {{token}}

### Lançamentos: buscar por id

GET {{Grana.Api_HostAddress}}/api/lancamentos/{{lancamentoId}}
Authorization: Bearer {{token}}

### Lançamentos: editar

PUT {{Grana.Api_HostAddress}}/api/lancamentos/{{lancamentoId}}
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "categoriaId": "{{categoriaDespesaId}}",
  "valor": 400.00,
  "data": "2026-11-20",
  "descricao": "Feira do mês"
}

### Transferências: criar

# @name criarTransferencia
POST {{Grana.Api_HostAddress}}/api/transferencias
Authorization: Bearer {{token}}
Content-Type: application/json

{
  "contaOrigemId": "{{contaId}}",
  "contaDestinoId": "{{contaDestinoId}}",
  "valor": 300.00,
  "data": "2026-11-21",
  "descricao": "Reserva de emergência"
}

### Transferências: listar

GET {{Grana.Api_HostAddress}}/api/transferencias
Authorization: Bearer {{token}}

### Transferências: listar com filtros

GET {{Grana.Api_HostAddress}}/api/transferencias?contaId={{contaId}}&dataInicio=2026-11-01&dataFim=2026-11-30
Authorization: Bearer {{token}}

### Transferências: buscar por id

GET {{Grana.Api_HostAddress}}/api/transferencias/{{transferenciaId}}
Authorization: Bearer {{token}}

### Orçamentos: mês atual

GET {{Grana.Api_HostAddress}}/api/orcamentos
Authorization: Bearer {{token}}

### Orçamentos: mês informado

GET {{Grana.Api_HostAddress}}/api/orcamentos?ano=2026&mes=11
Authorization: Bearer {{token}}

### Resumo: mês atual

GET {{Grana.Api_HostAddress}}/api/resumo
Authorization: Bearer {{token}}

### Resumo: mês informado

GET {{Grana.Api_HostAddress}}/api/resumo?ano=2026&mes=11
Authorization: Bearer {{token}}

### Extrato: mês atual

GET {{Grana.Api_HostAddress}}/api/contas/{{contaId}}/extrato
Authorization: Bearer {{token}}

### Extrato: período informado

GET {{Grana.Api_HostAddress}}/api/contas/{{contaId}}/extrato?dataInicio=2026-11-01&dataFim=2026-11-30
Authorization: Bearer {{token}}

### Transferências: excluir (desfaz os saldos)

DELETE {{Grana.Api_HostAddress}}/api/transferencias/{{transferenciaId}}
Authorization: Bearer {{token}}

### Lançamentos: excluir (estorna o saldo)

DELETE {{Grana.Api_HostAddress}}/api/lancamentos/{{lancamentoId}}
Authorization: Bearer {{token}}
